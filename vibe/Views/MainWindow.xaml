<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="vibe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:vibe"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views ="using:vibe.Views"
    mc:Ignorable="d"
    Title="vibe">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid
            x:Name="BackgroundStack"
            Grid.RowSpan="2">

            <MediaPlayerElement
                x:Name="LiveWallpaper"
                Stretch="UniformToFill"
                AutoPlay="True"
                AreTransportControlsEnabled="False"
                Source="C:\Users\sceth\Videos\LiveWallpaper\emma-sunset-field-sekiro-shadows-die-twice-moewalls-com.mp4" />

            <Border
                x:Name="WallpaperTeint"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#452E00"
                Opacity="0.5" />
        </Grid>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="Vibe"
            Subtitle=":3"
            IsBackButtonVisible="True"
            IsBackButtonEnabled="True"
            BackRequested="AppTitleBar_BackRequested" />

        <views:MainPage
            x:Name="WindowContent"
            Grid.Row="1"/>
    </Grid>

</Window>
