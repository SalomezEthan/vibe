<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="vibe.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:vibe.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:vibe.ViewModels"
    xmlns:converters="using:vibe.Converters" d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>

        <Grid.Resources>
            <converters:BoolToPlaybackStateIcons x:Key="PlayIconConverter" />
            <converters:BootToVisibility x:Key="BoolToVisibility" />
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="WindowPane"
            Grid.Column="0"
            RowSpacing="24">

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <TreeView
                x:Name="FolderTreeView"
                Grid.Row="0"
                ScrollViewer.VerticalScrollMode="Enabled"
                CanDragItems="False"
                AllowDrop="False"
                ItemsSource="{x:Bind viewModel.RootFolder.Subfolders}"
                SelectedItem="{x:Bind viewModel.SelectedFolder, Mode=TwoWay}">

                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:FolderViewModel">
                        <TreeViewItem 
                            FontSize="16"
                            Content="{x:Bind Name}"
                            ItemsSource="{x:Bind Subfolders}" />
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <StackPanel
                x:Name="MusicPlayerController"
                Grid.Row="1"
                Orientation="Vertical"
                Padding="16"
                Spacing="12"
                Visibility="{Binding Player.PlayerIsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">

                <StackPanel
                    x:Name="CurrentInfo"
                    Orientation="Vertical"
                    Spacing="4">

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind viewModel.Player.Current.Title, Mode=OneWay}" />

                    <TextBlock
                        FontWeight="SemiLight"
                        FontSize="8"
                        Text="{x:Bind viewModel.Player.Current.Artist, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    x:Name="PositionBar"
                    HorizontalAlignment="Stretch">

                    <Slider
                        HorizontalAlignment="Stretch"
                        Minimum="0"
                        Maximum="100"
                        IsThumbToolTipEnabled="False" />

                    <Grid x:Name="PositionInfo">

                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter
                                    Property="FontSize"
                                    Value="8" />

                                <Setter
                                    Property="FontWeight"
                                    Value="Light" />
                            </Style>
                        </Grid.Resources>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="00:00"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Column="1"
                            Text="00"
                            HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <StackPanel
                    x:Name="Controls"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8">

                    <StackPanel.Resources>

                        <Style
                            TargetType="Button"
                            BasedOn="{StaticResource DefaultButtonStyle}">

                            <Setter
                                Property="Background"
                                Value="Transparent" />

                            <Setter
                                Property="BorderBrush"
                                Value="Transparent" />
                        </Style>

                        <Style TargetType="FontIcon">
                            <Setter
                                Property="FontSize"
                                Value="14" />
                        </Style>
                    </StackPanel.Resources>

                    <ToggleButton
                        x:Name="Shuffle"
                        IsChecked="{x:Bind viewModel.Player.IsShuffled}"
                        Click="Shuffle_Click">

                        <FontIcon Glyph="&#xE8B1;" />
                    </ToggleButton>

                    <Button
                        x:Name="Previous"
                        Click="Previous_Click">

                        <FontIcon Glyph="&#xF8AC;" />
                    </Button>

                    <Button
                        x:Name="Play"
                        Click="Play_Click">

                        <FontIcon Glyph="{Binding Player.IsPlaying, Mode=OneWay, Converter={StaticResource PlayIconConverter}}" />
                    </Button>

                    <Button
                        x:Name="Next"
                        Click="Next_Click">

                        <FontIcon Glyph="&#xF8AD;" />
                    </Button>

                    <Button x:Name="Volume">

                        <Button.Content>
                            <FontIcon Glyph="&#xF4C3;" />
                        </Button.Content>


                        <Button.Flyout>
                            <Flyout>
                                <Slider
                                    x:Name="VolumeSlider"
                                    Orientation="Vertical"
                                    Height="100"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="10"
                                    TickPlacement="Outside"
                                    Value="{x:Bind viewModel.Player.Volume, Mode=TwoWay}"/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Frame
            x:Name="RootFrame"
            Grid.Column="1"
            Margin="36" />
    </Grid>
</Page>
